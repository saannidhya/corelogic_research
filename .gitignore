# CoreLogic research repository ignore rules

# Local agent/assistant workflow files. Keep these on this machine, but do not
# publish them in the research repo.
.claude/
.codex/
.agents/
.tmp/
CLAUDE.md
CLAUDE.local.md
MEMORY.md

# Local workflow logs, reviews, plans, scratch work, and templates.
quality_reports/
projects/*/quality_reports/
explorations/
tmp/
templates/
projects/_template/
master_supporting_docs/
scripts/quality_score.py
projects/*/LEARNING_GUIDE.md

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.synctex.gz
*.run.xml
*-blx.bib
projects/*/manuscript/*.aux
projects/*/manuscript/*.bbl
projects/*/manuscript/*.blg
projects/*/manuscript/*.log
projects/*/manuscript/*.out
projects/*/manuscript/*.toc
projects/*/manuscript/*.fls
projects/*/manuscript/*.fdb_latexmk
projects/*/manuscript/*.synctex.gz
projects/*/slides/*.aux
projects/*/slides/*.log
projects/*/slides/*.nav
projects/*/slides/*.out
projects/*/slides/*.snm
projects/*/slides/*.toc
projects/*/slides/*.vrb

# R
.Rproj.user/
.Rhistory
.RData
.Rdata
scripts/R/_outputs/
projects/*/scripts/R/_outputs/
projects/*/scripts/python/_outputs/
projects/*/scripts/julia/_outputs/
renv/library/
renv/local/
renv/staging/
renv/python/
renv/sandbox/
!renv/activate.R
!renv/settings.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
.uv/
*.egg-info/

# Julia
.julia/

# Quarto/rendering artifacts
.quarto/

# Data. Only documented structure and provenance markers are tracked.
/data/*
/data/*/*
!/data/.gitkeep
!/data/README.md
!/data/corelogic_extracts/
!/data/corelogic_baseline/
!/data/external/
!/data/derived/
!/data/corelogic_extracts/.gitkeep
!/data/corelogic_baseline/.gitkeep
!/data/corelogic_baseline/PROVENANCE.md
!/data/external/.gitkeep
!/data/derived/.gitkeep

# Large or regenerable data products
*.parquet
*.arrow
*.feather

# Copyrighted reference PDFs should not be redistributed from docs folders.
projects/*/docs/*.pdf
projects/*/docs/*.PDF
!projects/*/docs/README.md
!projects/*/docs/.gitkeep
