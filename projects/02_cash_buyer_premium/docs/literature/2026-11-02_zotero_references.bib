@misc{mateen_how_2026,
	title = {How {Housing} {Search} and {Bargaining} {Unfold}: {Evidence} from {Offer}-{Level} {Data}},
	url = {https://doi.org/10.2139/ssrn.3727150},
	doi = {10.2139/ssrn.3727150},
	abstract = {We study housing search and bargaining using a novel large-scale offer-level dataset from the U.S. market. We document a rich taxonomy of bargaining patterns, outcomes, and the dynamic evolution of surplus sharing. We then examine two potential strategic bargaining instruments. First, seller-side listing-price revisions are associated with additional bidders when revised downward, and higher subsequent offer prices when revised upward. Second, buyer-side non-price bid terms complement price competition, are more prevalent in competitive markets, and signal buyer commitment. Overall, our findings provide new evidence on the microstructure of housing bargaining and the strategic interactions between buyers and sellers.},
	language = {en},
	urldate = {2026-11-02},
