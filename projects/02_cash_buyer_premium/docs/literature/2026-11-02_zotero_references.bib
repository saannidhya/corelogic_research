@article{fuster_sensitivity_2021,
	title = {The {Sensitivity} of {Housing} {Demand} to {Financing} {Conditions}: {Evidence} from a {Survey}},
	volume = {13},
	url = {https://doi.org/10.1257/pol.20150337},
	doi = {10.1257/pol.20150337},
	abstract = {Measuring the sensitivity of housing demand to mortgage rates and available leverage is challenging because there is generally no exogenous variation in these variables. This paper circumvents this issue by designing a strategic survey in which respondents report their willingness to pay (WTP) for a home under different financing scenarios. Relaxation of down payment constraints or an exogenous increase in nonhousing wealth has large effects on WTP, especially for poorer and more credit-constrained households. However, changing the mortgage rate has only moderate effects on WTP. These findings have implications for theoretical models of house price determination and for policy. (JEL G21, G51, R21, R38)},
	language = {en},
	number = {1},
	urldate = {2026-11-02},
